<?xml version="1.0" encoding="UTF-8"?>
<server description="Simple Pharmacy Dashboard">

    <!-- Enable features -->
    <featureManager>
        <feature>servlet-4.0</feature>
        <feature>jsp-2.3</feature>
        <feature>jndi-1.0</feature>
    </featureManager>

    <!-- Bind only to localhost (security best practice) -->
    <httpEndpoint id="defaultHttpEndpoint"
                  host="127.0.0.1"
                  httpPort="9080"
                  httpsPort="9443" />

    <!-- Automatically expand WAR files and EAR files -->
    <applicationManager autoExpand="true"/>

    <!-- Deploy the pharmacy application -->
    <webApplication id="simple-pharmacy"
                    location="simple-pharmacy.war"
                    contextRoot="/pharmacy" />

    <!-- Default SSL configuration enables trust for default certificates from the Java runtime -->
    <ssl id="defaultSSLConfig" trustDefaultCerts="true" />
</server>
